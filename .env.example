# InsightX Platform Environment Configuration

# Application
APP_NAME=InsightX
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=change-this-in-production-super-secret-key-32-chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL / SQLite fallback for lightweight local dev)
DATABASE_URL=sqlite:///./insightx.db
# DATABASE_URL=postgresql://insightx_user:insightx_pass@localhost:5432/insightx_db

# File Storage
UPLOAD_DIR=./data/raw
PROCESSED_DIR=./data/processed
MAX_UPLOAD_SIZE_MB=50

# AI / LLM Configuration
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.0-flash

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
